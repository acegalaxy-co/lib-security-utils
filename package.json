{
  "name": "@acegalaxy/security-utils",
  "version": "0.1.2",
  "description": "Security/trust layer primitives: audit-log + caller-validator + rate-limit + vault-loader. Bundle of 4 small libs for production gateways.",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./audit-log": {
      "types": "./dist/audit-log/index.d.ts",
      "default": "./dist/audit-log/index.js"
    },
    "./caller-validator": {
      "types": "./dist/caller-validator/index.d.ts",
      "default": "./dist/caller-validator/index.js"
    },
    "./rate-limit": {
      "types": "./dist/rate-limit/index.d.ts",
      "default": "./dist/rate-limit/index.js"
    },
    "./vault-loader": {
      "types": "./dist/vault-loader/index.d.ts",
      "default": "./dist/vault-loader/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist",
    "pretest": "npm run build"
  },
  "keywords": [
    "security",
    "rate-limit",
    "audit",
    "vault",
    "notion",
    "secrets",
    "caller-validator"
  ],
  "author": "ACE Galaxy <hello@acegalaxy.co>",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acegalaxy-co/ace_commons-security-utils-nodejs.git"
  },
  "bugs": {
    "url": "https://github.com/acegalaxy-co/ace_commons-security-utils-nodejs/issues"
  },
  "homepage": "https://github.com/acegalaxy-co/ace_commons-security-utils-nodejs#readme",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^20.0.0"
  }
}
